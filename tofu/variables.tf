variable "kubeconfig_path" {
  description = "Path to the Talos cluster's kubeconfig, generated by the proxmox-tofu / talosctl bootstrap."
  type        = string
  default     = "../../proxmox-tofu/_out/kubeconfig"
}

variable "namespace" {
  description = "Namespace to install admin-ui into. Must already exist."
  type        = string
  default     = "admin-ui-dev-pub"
}

variable "image_repository" {
  description = "Registry + repository for the admin-ui image (the in-cluster Nexus docker-hosted repo, provisioned in cluster-config)."
  type        = string
  default     = "registry.clusterkeep.dev.net/admin-ui"
}

variable "image_tag" {
  description = "For dev/preview (image_tag_prefix != \"\"): fallback tag, used only if no pushed tag matches image_tag_prefix yet. For prd (image_tag_prefix == \"\"): leave blank to deploy the highest vX.Y.Z tag on GitHub; set it (e.g. -var image_tag=v1.6.0) to pin a release or roll back."
  type        = string
  default     = ""
}

variable "image_tag_prefix" {
  description = "Which branch's tag channel this environment tracks: \"DEV-\" or \"PREVIEW-\". \"\" (prd) deploys release tags instead - see image_tag."
  type        = string
  default     = "DEV-"
}

variable "ingress_hostname" {
  description = "Hostname admin-ui will be served on via Ingress."
  type        = string
  default     = "admin-dev.clusterkeep.dev.net"
}

variable "ingress_enabled" {
  description = "Whether to create a LAN Ingress for this instance. Disable for prd - it's reached only via the Cloudflare Tunnel, and an Ingress would collide with the dev instance's hostname."
  type        = bool
  default     = true
}

variable "image_pull_secret_name" {
  description = "Name of the imagePullSecret to use, if the Nexus docker-hosted repo requires auth. Leave blank if the repo allows anonymous pulls."
  type        = string
  default     = ""
}


variable "auth_api_internal_url" {
  description = "In-cluster Service URL for auth-api. Used for this backend's own server-to-server session check -- the public hostname above only resolves for browsers, not pods."
  type        = string
  default     = "http://auth-api.auth-dev-pub.svc.cluster.local"
}

variable "clusterkeep_ui_base_url" {
  description = "clusterkeep-ui URL a signed-out admin is sent to after logging out."
  type        = string
  default     = "https://dev.clusterkeep.dev.net"
}

variable "storage_ui_base_url" {
  description = "storage-ui URL the header back button targets."
  type        = string
  default     = "https://storage-dev.clusterkeep.dev.net"
}

variable "headlamp_url" {
  description = "Headlamp URL the header button targets. Set to \"\" to hide the button."
  type        = string
  default     = "https://headlamp.clusterkeep.dev.net"
}

variable "storage_api_url" {
  description = "In-cluster storage-api URL used to show and set each user's quota. Blank hides storage details."
  type        = string
  default     = ""
}

variable "storage_api_token" {
  description = "Shared bearer token for storage-api. Must match storage-api's service_token."
  type        = string
  default     = ""
  sensitive   = true
}

variable "lettermint_api_token" {
  description = "Lettermint project API token used to email invite links. Blank hides the email field."
  type        = string
  default     = ""
  sensitive   = true
}

variable "invite_email_from" {
  description = "Sender for invite emails. The domain must be verified in Lettermint."
  type        = string
  default     = "ClusterKeep <noreply@clusterkeep.com>"
}

variable "invite_email_contact" {
  description = "Contact address shown at the bottom of invite emails. Blank leaves it out."
  type        = string
  default     = ""
}
